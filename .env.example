# Generate the first two with: npm run secrets
SESSION_SECRET=
INVITE_CODE=

# Added by the Neon integration in Vercel (Storage tab)
DATABASE_URL=

# Required: reads your meal photos. Free key from console.groq.com > API Keys
AI_API_KEY=

# Optional: any OpenAI-compatible provider and vision model.
# Defaults: Groq + Qwen 3.8 27B (open weights)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=qwen/qwen3.8-27b
